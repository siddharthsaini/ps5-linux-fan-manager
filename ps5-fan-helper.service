[Unit]
Description=PS5 Fan Manager privileged helper
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/lib/ps5-fan-manager/ps5-fan-helper --uid=@UID@
Restart=on-failure
RestartSec=2
RuntimeDirectory=ps5-fan-manager
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
