def make_icons():
    directory = os.path.join(GLib.get_user_cache_dir(), "ps5-fan-manager")
    os.makedirs(directory, exist_ok=True)
    paths = {}
    for name, color in ICON_COLORS.items():
        path = os.path.join(directory, f"ps5-fan-{name}.svg")
        content = FAN_SVG.format(color=color)
        try:
            with open(path, "r", encoding="utf-8") as handle:
                old = handle.read()
        except OSError:
            old = None
        if old != content:
            try:
                with open(path, "w", encoding="utf-8") as handle:
                    handle.write(content)
            except OSError:
                pass
        paths[name] = path
    return paths


def acquire_instance_lock():
    directory = os.path.join(GLib.get_user_cache_dir(), "ps5-fan-manager")
    os.makedirs(directory, exist_ok=True)
    handle = open(os.path.join(directory, "instance.lock"), "w", encoding="ascii")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        return None
    handle.write(str(os.getpid()))
    handle.flush()
    return handle


class HelperClient:
    def __init__(self, socket_path, on_status, on_link):
        self.socket_path = socket_path
        self.on_status = on_status
        self.on_link = on_link
        self.state = None
        self.sock = None
        self.lock = threading.Lock()
        self.running = False
        self.thread = None

    def start(self):
        self.running = True
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def stop(self):
        self.running = False
        with self.lock:
            sock = self.sock
            self.sock = None
        if sock:
            try:
                sock.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            try:
                sock.close()
            except OSError:
                pass

    def apply_state(self, state):
        self.state = state
        line = json.dumps({"cmd": "state", "state": state}) + "\n"
        with self.lock:
            if self.sock:
                try:
                    self.sock.sendall(line.encode("utf-8"))
                except OSError:
                    pass

    def _post(self, callback, *args):
        GLib.idle_add(callback, *args)

    def _run(self):
        while self.running:
            sock = None
            try:
                sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                sock.settimeout(3.0)
                sock.connect(self.socket_path)
                sock.settimeout(None)
                with self.lock:
                    self.sock = sock
                    if self.state is not None:
                        payload = json.dumps({"cmd": "state", "state": self.state})
                        sock.sendall((payload + "\n").encode("utf-8"))
                self._post(self.on_link, True)

                buffer = b""
                while self.running:
                    data = sock.recv(65536)
                    if not data:
                        break
                    buffer += data
                    while b"\n" in buffer:
                        line, buffer = buffer.split(b"\n", 1)
                        if not line.strip():
                            continue
                        try:
                            message = json.loads(line)
                        except (ValueError, TypeError):
                            continue
                        self._post(self.on_status, message)
            except OSError:
                pass
            finally:
                with self.lock:
                    if self.sock is sock:
                        self.sock = None
                if sock:
                    try:
                        sock.close()
                    except OSError:
                        pass
                self._post(self.on_link, False)
            if self.running:
                time.sleep(2.0)


class FanApp:
    def __init__(self, show_window=False):
        self.config = core.load_config()
        self.status = {}
        self.connected = False
        self.updating = False
        self.icons = make_icons()

        self._build_indicator()
        self._build_menu()
        self._build_window()

        self.client = HelperClient(core.SOCKET_PATH, self._on_status, self._on_link)
        self.client.apply_state(self.config)
        self._update_controls()
        self._update_display()
        self.client.start()

        if show_window:
            self.show_window()

    # ---- UI construction ---------------------------------------------
    def _build_indicator(self):
        self.indicator = AppIndicator.Indicator.new(
            "ps5-fan-manager",
            self.icons["grey"],
            AppIndicator.IndicatorCategory.HARDWARE,
        )
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("PS5 Fan Manager")
        self.indicator.set_label("–", "Fan temperature")

    def _build_menu(self):
        self.menu = Gtk.Menu()
        self.menu_header = Gtk.MenuItem(label="Helper unavailable")
        self.menu_header.set_sensitive(False)
        self.menu.append(self.menu_header)
        self.menu.append(Gtk.SeparatorMenuItem())

        self.mode_items = {}
        first = None
        for mode, label in (
            ("auto", "Auto"),
            ("manual", "Manual"),
        ):
            if first is None:
                item = Gtk.RadioMenuItem.new_with_label(None, label)
                first = item
            else:
                item = Gtk.RadioMenuItem.new_with_label_from_widget(first, label)
            item.connect("toggled", self._on_menu_mode, mode)
            self.menu.append(item)
            self.mode_items[mode] = item

        self.menu.append(Gtk.SeparatorMenuItem())
        settings = Gtk.MenuItem(label="Settings…")
        settings.connect("activate", self.show_window)
        self.menu.append(settings)
        quit_item = Gtk.MenuItem(label="Quit")
        quit_item.connect("activate", self.quit)
        self.menu.append(quit_item)
        self.menu.show_all()
        self.indicator.set_menu(self.menu)

    def _build_window(self):
        self.window = Gtk.Window(title="PS5 Fan Manager")
        self.window.set_default_size(500, -1)
        self.window.set_border_width(16)
        self.window.connect("delete-event", self._hide_window)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.window.add(box)

        title = Gtk.Label()
        title.set_markup("<b>PS5 Fan Manager</b>")
        title.set_xalign(0)
        box.pack_start(title, False, False, 0)

        self.status_label = Gtk.Label()
        self.status_label.set_xalign(0)
        self.status_label.set_line_wrap(True)
        box.pack_start(self.status_label, False, False, 0)

        box.pack_start(Gtk.Separator(), False, False, 4)

        self.mode_combo = Gtk.ComboBoxText()
        for mode, label in (
            ("auto", "Auto — target temperature"),
            ("manual", "Manual — direct PWM"),
        ):
            self.mode_combo.append(mode, label)
        self.mode_combo.connect("changed", self._on_mode_changed)
        box.pack_start(self._row("Mode", self.mode_combo), False, False, 0)

        self.target_scale = self._scale(40, 90, 1)
        self.target_scale.connect("value-changed", self._on_target)
        self.target_row = self._row("Target (°C)", self.target_scale)
        box.pack_start(self.target_row, False, False, 0)

        self.manual_scale = self._scale(core.MIN_PWM, core.MAX_PWM, 1)
        self.manual_scale.connect("value-changed", self._on_manual_pwm)
        self.manual_row = self._row("Manual PWM (26–255)", self.manual_scale)
        box.pack_start(self.manual_row, False, False, 0)

        self.min_spin = self._spin(core.MIN_PWM)
        self.min_spin.connect("value-changed", self._on_range_changed)
        self.max_spin = self._spin(core.MAX_PWM)
        self.max_spin.connect("value-changed", self._on_range_changed)
        range_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        range_box.pack_start(Gtk.Label(label="0%"), False, False, 0)
        range_box.pack_start(self.min_spin, False, False, 0)
        range_box.pack_start(Gtk.Label(label="100%"), False, False, 0)
        range_box.pack_start(self.max_spin, False, False, 0)
        box.pack_start(self._row("Fan range (PWM)", range_box), False, False, 0)
        box.pack_start(
            self._hint("Safety floor is 26. Manual mode ignores this range."),
            False,
            False,
            0,
        )

        self.hottest_check = Gtk.CheckButton(
            label="Use hottest PS5 sensor instead of MainSoC"
        )
        self.hottest_check.connect("toggled", self._on_check_changed)
        box.pack_start(self.hottest_check, False, False, 0)

        self.restore_check = Gtk.CheckButton(
            label="Restore driver automatic mode on exit"
        )
        self.restore_check.connect("toggled", self._on_check_changed)
        box.pack_start(self.restore_check, False, False, 0)

        self.show_check = Gtk.CheckButton(label="Show temperature in the top bar")
        self.show_check.connect("toggled", self._on_check_changed)
        box.pack_start(self.show_check, False, False, 0)

        legend = self._hint(
            "Sensor colour:  green < 70°C   ·   yellow 70–<85°C   ·   red ≥ 85°C"
        )
        box.pack_start(legend, False, False, 0)

        self.sensors_label = Gtk.Label()
        self.sensors_label.set_xalign(0)
        self.sensors_label.set_line_wrap(True)
        self.sensors_label.set_selectable(True)
        box.pack_start(self.sensors_label, False, False, 0)

        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda _button: self.window.hide())
        box.pack_end(close, False, False, 4)

    @staticmethod
    def _row(label_text, widget):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        label = Gtk.Label(label=label_text)
        label.set_xalign(0)
        label.set_size_request(150, -1)
        row.pack_start(label, False, False, 0)
        row.pack_start(widget, True, True, 0)
        return row

    @staticmethod
    def _scale(low, high, step):
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, low, high, step)
        scale.set_digits(0)
        scale.set_draw_value(True)
        scale.set_value_pos(Gtk.PositionType.RIGHT)
        scale.set_hexpand(True)
        return scale

    @staticmethod
    def _spin(value):
        adjustment = Gtk.Adjustment(
            value=value, lower=core.MIN_PWM, upper=core.MAX_PWM,
            step_increment=1, page_increment=10,
        )
        return Gtk.SpinButton(adjustment=adjustment, climb_rate=1, digits=0)

    @staticmethod
    def _hint(text):
        label = Gtk.Label(label=text)
        label.set_xalign(0)
        label.set_line_wrap(True)
        label.get_style_context().add_class("dim-label")
        return label

    # ---- configuration ------------------------------------------------
    def _push_config(self):
        self.config = core.normalize_config(self.config)
        try:
            core.save_config(self.config)
        except OSError as exc:
            print(f"Could not save config: {exc}", file=sys.stderr)
        self.client.apply_state(self.config)
        self._update_controls()
        self._update_display()

    def _on_mode_changed(self, combo):
        if self.updating:
            return
        mode = combo.get_active_id()
        if mode:
            self.config["mode"] = mode
            self._push_config()

    def _on_menu_mode(self, item, mode):
        if self.updating or not item.get_active():
            return
        self.config["mode"] = mode
        self._push_config()

    def _on_target(self, scale):
        if self.updating:
            return
        self.config["target"] = int(scale.get_value())
        self._push_config()

    def _on_manual_pwm(self, scale):
        if self.updating:
            return
        self.config["manual_pwm"] = int(scale.get_value())
        self._push_config()

    def _on_range_changed(self, _spin):
        if self.updating:
            return
        self.config["min_pwm"] = int(self.min_spin.get_value())
        self.config["max_pwm"] = int(self.max_spin.get_value())
        if self.config["max_pwm"] < self.config["min_pwm"]:
            self.config["max_pwm"] = self.config["min_pwm"]
        self._push_config()

    def _on_check_changed(self, _check):
        if self.updating:
            return
        self.config["use_hottest"] = self.hottest_check.get_active()
        self.config["restore_on_exit"] = self.restore_check.get_active()
        self.config["show_temp"] = self.show_check.get_active()
        self._push_config()

    def _update_controls(self):
        self.updating = True
        try:
            self.mode_combo.set_active_id(self.config["mode"])
            self.target_scale.set_value(self.config["target"])
            self.manual_scale.set_value(self.config["manual_pwm"])
            self.min_spin.set_value(self.config["min_pwm"])
            self.max_spin.set_value(self.config["max_pwm"])
            self.hottest_check.set_active(self.config["use_hottest"])
            self.restore_check.set_active(self.config["restore_on_exit"])
            self.show_check.set_active(self.config["show_temp"])
            for mode, item in self.mode_items.items():
                item.set_active(mode == self.config["mode"])
            mode = self.config["mode"]
            self.target_row.set_sensitive(mode == "auto")
            self.manual_row.set_sensitive(mode == "manual")
        finally:
            self.updating = False

    # ---- status -------------------------------------------------------
    def _on_link(self, connected):
        self.connected = bool(connected)
        if not connected:
            self.status = {}
        self._update_display()
        return False

    def _on_status(self, message):
        if isinstance(message, dict) and message.get("type") == "status":
            self.status = message
            self.connected = True
            self._update_display()
        return False

    def _mode_name(self):
        return {
            "auto": "Auto",
            "manual": "Manual",
        }.get(self.config["mode"], self.config["mode"])

    def _header_text(self):
        if not self.connected:
            return "Helper unavailable"
        fault = self.status.get("fault")
        if fault:
            return f"Error: {fault}"
        temp = self.status.get("temp")
        pwm = self.status.get("pwm")
        if temp is None:
            return "Waiting for temperature…"
        sensor = self.status.get("sensor") or "Sensor"
        if pwm is None:
            return f"{sensor} {temp:.1f}°C"
        return (
            f"{sensor} {temp:.1f}°C · Fan {pwm}/255 "
            f"({core.pwm_percent(pwm)}%)"
        )

    def _update_display(self):
        if not hasattr(self, "indicator"):
            return
        temp = self.status.get("temp")
        color = core.temp_color(temp) if self.connected else "grey"
        self.indicator.set_icon_full(self.icons[color], f"PS5 fan {color}")
        if self.config["show_temp"] and self.connected and temp is not None:
            self.indicator.set_label(f"{temp:.0f}°", f"{temp:.1f}°C")
        else:
            self.indicator.set_label("", "")

        header = self._header_text()
        self.menu_header.set_label(header)

        if self.connected:
            fault = self.status.get("fault")
            if fault:
                self.status_label.set_text(f"Mode: {self._mode_name()} · {fault}")
            else:
                target = self.status.get("target")
                spec = f" · target {target:.0f}°C" if target is not None else ""
                self.status_label.set_text(f"Mode: {self._mode_name()}{spec}")
        else:
            self.status_label.set_text("Mode: — · privileged helper unavailable")

        temps = self.status.get("temps") or []
        if temps:
            self.sensors_label.set_text(
                "Temperatures:  "
                + "   ".join(f"{s['label']} {s['celsius']:.1f}°C" for s in temps)
            )
        else:
            self.sensors_label.set_text("Temperatures:  no data")

    def show_window(self, *_args):
        self.window.show_all()
        self.window.present()

    def _hide_window(self, *_args):
        self.window.hide()
        return True

    def quit(self, *_args):
        self.client.stop()
        Gtk.main_quit()


def main():
    lock = acquire_instance_lock()
    if lock is None:
        print("PS5 Fan Manager is already running.", file=sys.stderr)
        return 0
    app = FanApp(show_window="--show" in sys.argv[1:])
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
